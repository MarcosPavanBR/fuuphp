# Modelo do .env de PRODUÇÃO (go-live, passo 8).
#
# Na VPS este arquivo vira /etc/fuuphp/fuuphp.env:
#   - dono fuuphp, permissão 600 (chmod 600) -- só o PHP-FPM e o cron leem;
#   - fora do projeto e fora da raiz servida; nunca no git, nunca no front;
#   - o PHP-FPM e o cron apontam pra ele com FUU_ENV_FILE
#     (deploy/php-fpm/fuuphp.conf, deploy/cron/fuuphp).
#
# Este modelo NÃO tem segredo nenhum: cada <...> é preenchido na VPS.
# Se faltar qualquer coisa, a API não sobe (lib/core/production_guard.php) e o
# deploy recusa a versão (bin/check_production.php) -- é de propósito.
#
# Homologação (staging, passo 2): copie para /etc/fuuphp/staging.env, troque
# APP_ENV=staging e use as credenciais de TESTE do Mercado Pago (TEST-...).

APP_ENV=production

# Banco: a API conecta como app_rw (sujeito à RLS), nunca como postgres.
# Senha definida com deploy/postgres/set_passwords.sql.
DATABASE_URL=postgres://app_rw:<senha-do-app_rw>@127.0.0.1:5432/fuudelivery

# 64+ caracteres aleatórios: php -r 'echo bin2hex(random_bytes(48)), "\n";'
# Trocar invalida todas as sessões (todo mundo entra de novo).
JWT_SECRET=<gerar>

# PWA e API no mesmo domínio atrás do Cloudflare: sem CORS. A linha precisa
# EXISTIR, vazia -- ausente, a trava recusa (o padrão de dev liberaria localhost).
ALLOWED_ORIGIN=

# Endereço público do site, sem barra no fim. Só o build do front usa (a
# imagem da prévia do link no WhatsApp precisa de endereço absoluto).
PUBLIC_ORIGIN=https://<dominio>

# Mercado Pago -- conta da PLATAFORMA (decisão do Marcos: token único; a
# loja recebe pelo repasse semanal do livro-razão, não por split).
# Painel do MP > Suas integrações > Credenciais de PRODUÇÃO.
MERCADOPAGO_MODE=live
MERCADOPAGO_ACCESS_TOKEN=<APP_USR-...>
MERCADOPAGO_PUBLIC_KEY=<APP_USR-...>
# Suas integrações > Webhooks > "Assinatura secreta". URL a cadastrar:
# https://<dominio>/api/v1/payments/webhook_mercadopago.php  (eventos: Pagamentos)
MERCADOPAGO_WEBHOOK_SECRET=<assinatura-secreta>

# OTP (código de login) por SMS, pela Twilio (decisão do Marcos).
# Console da Twilio > Account Info: Account SID (AC...) e Auth Token.
# Remetente: um número Twilio habilitado pra SMS no Brasil (+55...) em
# TWILIO_FROM -- ou, se preferir um Messaging Service, troque a linha
# TWILIO_FROM por TWILIO_MESSAGING_SERVICE_SID=MG...
# Login por e-mail fica indisponível (a Twilio não manda e-mail por esta API);
# o app esconde a opção sozinho.
OTP_SENDER=twilio
TWILIO_ACCOUNT_SID=<AC...>
TWILIO_AUTH_TOKEN=<auth-token>
TWILIO_FROM=<+55...>
# Opcional: "Receber por WhatsApp" na tela do código, com remetente de
# WhatsApp aprovado na Twilio. Sem a linha, a opção não aparece.
# TWILIO_WHATSAPP_FROM=+55...

# Push (tela 7.2). Chave gerada uma vez com:
#   sudo -u fuuphp FUU_ENV_FILE=/etc/fuuphp/fuuphp.env php bin/generate_vapid_keys.php
PUSH_MODE=live
VAPID_PRIVATE_KEY_FILE=/var/fuuphp/storage/vapid/private.pem
VAPID_SUBJECT=mailto:<contato-do-suporte>

# Arquivos enviados (fase 1 do storage: disco da VPS, fora do projeto).
# Comprovantes e documentos de entregador NUNCA são públicos: só saem pelas
# rotas autenticadas da API. Fotos do cardápio saem pela rota pública.
PROOF_STORAGE_DIR=/var/fuuphp/storage/proofs
MENU_PHOTO_DIR=/var/fuuphp/storage/menu
COURIER_DOC_DIR=/var/fuuphp/storage/courier_docs
