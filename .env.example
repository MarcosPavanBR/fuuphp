DATABASE_URL=postgres://postgres:postgres@localhost:5432/fuudelivery
JWT_SECRET=troque-por-um-segredo-de-verdade-no-vault
APP_ENV=development
# origem do front-end em dev (Vite). Em produção, deixe vazio se PWA e API
# ficarem no mesmo domínio via Cloudflare -- aí não precisa de CORS.
ALLOWED_ORIGIN=http://localhost:5173

# Mercado Pago (cláusula zero: único gateway -- nunca AbacatePay). Sem
# MERCADOPAGO_ACCESS_TOKEN, o módulo de pagamentos roda em modo "fake"
# (MERCADOPAGO_MODE=fake): simula aprovação/recusa de cartão e geração de
# Pix automático no mesmo formato da API real, para dar pra testar e rodar
# o front sem uma conta sandbox de verdade. Em produção, preencha as três.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_MODE=
MERCADOPAGO_WEBHOOK_SECRET=

# Pasta onde os comprovantes de Pix ficam guardados (Fase 4.4). Em produção
# isto é um bucket privado com URL assinada (Cloudflare R2/S3) -- aqui é
# disco local porque este ambiente não tem um bucket real configurado.
PROOF_STORAGE_DIR=storage/proofs

# Outras pastas de arquivo enviado (todas relativas à raiz do projeto, ou
# caminho absoluto). Fotos do cardápio são públicas; documentos de
# candidatura de entregador, não.
MENU_PHOTO_DIR=storage/menu
COURIER_DOC_DIR=storage/courier_docs

# Push (tela 7.2). PUSH_MODE=live chama os serviços de push de verdade; vazio
# = fake (grava e conta, não sai da máquina). A chave VAPID é gerada uma vez
# com `php bin/generate_vapid_keys.php` e mora fora da raiz servida.
PUSH_MODE=
VAPID_PRIVATE_KEY_FILE=storage/vapid/private.pem
VAPID_SUBJECT=mailto:suporte@fuudelivery.com.br

# Public Key do Mercado Pago (pública: vai pro navegador pra o MercadoPago.js
# tokenizar o cartão -- tela 4.2). Só é usada em modo live.
MERCADOPAGO_PUBLIC_KEY=

# OTP (login por SMS/e-mail). Vazio em development/testing = driver "log":
# o código não sai da máquina (vem em dev_code na resposta) e nem vai pro
# log. Em production/staging precisa ser um provedor real -- ainda não
# escolhido; sem ele a API não sobe (lib/core/production_guard.php).
OTP_SENDER=

# Produção: o modelo completo está em deploy/env/fuuphp.env.example e o
# passo a passo em docs/GO_LIVE.md. APP_ENV=production/staging com qualquer
# integração simulada ou sem segredo = a API não sobe.
